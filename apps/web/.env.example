# Copier ce fichier en ".env.local" (en local) ou renseigner ces variables dans le panneau Hostinger.
# Ne jamais mettre les vraies valeurs dans Git.

# --- Formulaire de contact : envoi des emails via l'API (hébergée avec l'API AMEG) ---
MAJELI_MAIL_API_URL=https://api.ameginternational.com/api/majeli/contact
# Même valeur que MAJELI_API_KEY dans le .env de l'API (64 caractères)
MAJELI_MAIL_API_KEY=remplacer-par-la-cle-partagee
