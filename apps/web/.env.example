# Copier ce fichier en ".env.local" (en local) ou renseigner ces variables dans le panneau Hostinger.
# Ne jamais mettre les vraies valeurs dans Git.

# Adresse de PocketBase vue depuis le serveur Next.js
POCKETBASE_URL=http://127.0.0.1:8090

# Compte superuser PocketBase utilisé par les routes API (formulaire de contact + admin)
PB_SUPERUSER_EMAIL=admin@majeliconnect.com
PB_SUPERUSER_PASSWORD=remplacer-par-un-mot-de-passe-long-et-unique

# Jeton secret pour appeler /api/admin/* (32 caractères minimum)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=remplacer-par-un-jeton-aleatoire-de-64-caracteres
